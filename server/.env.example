# Copier en .env (non versionné). Identifiants du compte admin, lus au premier démarrage uniquement :
# ensuite le mot de passe se change depuis la page /admin/.
ADMIN_USER=
ADMIN_PASSWORD=

# Mail envoyé à chaque nouvel agent (SMTP authentifié, par exemple Amazon SES).
# SMTP_TLS=true : TLS direct (port 465) ; sinon STARTTLS (port 587). MAIL_FROM vaut NOTIFY_EMAIL par défaut
# et doit être une adresse d’expédition autorisée par le serveur SMTP.
NOTIFY_EMAIL=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=
